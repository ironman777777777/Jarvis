
/* JARVIS HUD — Mark I */
/* Visual foundation */

:root {
  --bg: #050b14;
  --panel: rgba(10, 24, 40, 0.88);
  --cyan: #51eaff;
  --blue: #168dff;
  --muted: #7599b3;
  --line: rgba(81, 234, 255, 0.25);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--bg);
}

body {
  min-height: 100vh;
  margin: 0;
  padding: 20px;
  color: #d9f8ff;
  background:
    radial-gradient(
      ellipse at top,
      #102b42 0%,
      var(--bg) 65%
    );
  font-family: "Rajdhani", "Arial", sans-serif;
}

h1,
h2,
h3 {
  color: var(--cyan);
  font-family: "Orbitron", "Arial", sans-serif;
  letter-spacing: 0.08em;
  text-shadow: 0 0 12px rgba(81, 234, 255, 0.3);
}

button,
input,
textarea {
  font: inherit;
}

button {
  color: var(--cyan);
  background: rgba(22, 141, 255, 0.12);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 10px 16px;
  cursor: pointer;
}

button:hover {
  background: rgba(81, 234, 255, 0.15);
  border-color: var(--cyan);
}

input,
textarea {
  max-width: 100%;
  color: #d9f8ff;
  background: #081522;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 10px;
}

.panel,
.card,
section {
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--panel);
  box-shadow: 0 0 18px rgba(22, 141, 255, 0.07);
  padding: 16px;
}

a {
  color: var(--cyan);
}

hr {
  border: 0;
  border-top: 1px solid var(--line);
}

@media (max-width: 600px) {
  body {
    padding: 12px;
  }

  .panel,
  .card,
  section {
    padding: 12px;
  }
}

/* JARVIS ASSISTANT PANEL */
.assistant-panel {
  max-width: 760px;
  margin: 32px auto;
  padding: 24px;
  color: #d9faff;
  background: rgba(5, 16, 30, 0.94);
  border: 1px solid rgba(81, 234, 255, 0.45);
  border-radius: 18px;
  box-shadow: 0 0 28px rgba(22, 141, 255, 0.14);
  font-family: 'Rajdhani', sans-serif;
}

.assistant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(81, 234, 255, 0.2);
}

.jarvis-status {
  color: #51eaff;
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 3px;
}

.status-light {
  display: inline-block;
  width: 9px;
  height: 9px;
  margin-right: 8px;
  background: #51eaff;
  border-radius: 50%;
  box-shadow: 0 0 12px #51eaff;
}

.assistant-label,
.system-status {
  color: #7599b3;
  font-size: 0.8rem;
  letter-spacing: 2px;
}

.jarvis-core {
  padding: 30px 0;
  text-align: center;
}

.core-ring {
  display: grid;
  place-items: center;
  width: 130px;
  height: 130px;
  margin: 0 auto 18px;
  border: 2px solid #51eaff;
  border-radius: 50%;
  box-shadow: 0 0 18px rgba(81, 234, 255, 0.4),
              inset 0 0 18px rgba(81, 234, 255, 0.15);
}

.core-inner {
  display: grid;
  place-items: center;
  width: 92px;
  height: 92px;
  border: 1px solid #168dff;
  border-radius: 50%;
  color: #51eaff;
  font-size: 3rem;
  font-weight: 600;
  text-shadow: 0 0 15px #51eaff;
}

.system-status {
  color: #51eaff;
}

.system-message {
  color: #b5cbd8;
}

.jarvis-controls {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}

.jarvis-controls button {
  padding: 12px 22px;
  color: #51eaff;
  background: transparent;
  border: 1px solid #168dff;
  border-radius: 6px;
  font-weight: 700;
  letter-spacing: 1px;
}

.jarvis-controls button:active {
  background: rgba(81, 234, 255, 0.15);
}

.jarvis-response {
  margin-top: 20px;
  padding: 14px;
  color: #91b9cc;
  background: rgba(22, 141, 255, 0.07);
  border-left: 2px solid #51eaff;
}

@media (max-width: 480px) {
  .assistant-panel {
    margin: 18px 8px;
    padding: 16px;
  }
}

